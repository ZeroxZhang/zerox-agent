{
  "name": "zerox-agent",
  "version": "3.8.1",
  "description": "Zerox Agent, a local-first desktop agent built module by module.",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:main": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on dist-electron/main/main.js dist-electron/preload/index.js http://127.0.0.1:5173 && ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "start": "electron .",
    "start:prod": "npm run build && electron .",
    "build": "npm run clean && tsc -p tsconfig.electron.json && tsc -p tsconfig.renderer.json --noEmit && vite build",
    "verify": "npm test && npm run build && node scripts/run-agent-evals.mjs && node scripts/run-memory-evals.mjs",
    "doctor": "npm run verify",
    "smoke:llm": "npm run build && node scripts/check-api-info.mjs",
    "smoke:providers": "npm run build && node scripts/smoke-multi-provider.mjs",
    "smoke:prod": "npm run build && BUILDING_AGENT_SMOKE=1 electron .",
    "validate:agent": "npm run build && BUILDING_AGENT_VALIDATE=1 electron .",
    "eval:agent": "npm run build && node scripts/run-agent-evals.mjs",
    "eval:agent:built": "node scripts/run-agent-evals.mjs",
    "eval:memory": "npm run build && node scripts/run-memory-evals.mjs",
    "eval:memory:built": "node scripts/run-memory-evals.mjs",
    "harness:check": "node scripts/check-harness-state.mjs",
    "harness:score": "npm run build && node scripts/run-harness-score.mjs",
    "harness:score:built": "node scripts/run-harness-score.mjs",
    "episode:export": "npm run build && node scripts/export-agent-episode.mjs",
    "episode:export:built": "node scripts/export-agent-episode.mjs",
    "smoke:prod:built": "BUILDING_AGENT_SMOKE=1 electron .",
    "pack:mac": "node scripts/package-mac.mjs --dir",
    "dist:mac": "node scripts/package-mac.mjs dmg zip",
    "release:sign": "node scripts/sign-update-manifest.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:mac": "npm run dist:mac && npm run release:sign && npm run release:preflight",
    "release:publish": "node scripts/publish-github-release.mjs",
    "clean": "rm -rf dist dist-electron",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1098.0",
    "@aws-sdk/credential-providers": "^3.1098.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "google-auth-library": "^10.9.1",
    "ipaddr.js": "^2.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "undici": "^7.28.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.1",
    "@electron/rebuild": "^4.2.0",
    "@noble/hashes": "^2.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.10"
  }
}
